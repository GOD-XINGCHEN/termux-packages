#!/data/data/me.sources.ai.debug/files/usr/bin/bash
# =============================================================================
# Sources-AI DEXKit —— APK 脱壳 / 逆向一体入口
#
#   Sources-AI-unpack env                  环境自检（root / frida / 工具链）
#   Sources-AI-unpack static <apk> [-o D]  静态反编译：apktool(资源+smali) + jadx(java)
#   Sources-AI-unpack root <包名|apk>       root 模式：frida 内存脱壳（服务端/inject）
#   Sources-AI-unpack gadget <apk> [-o A]   免 root：注入 frida-gadget 重打包并签名
#   Sources-AI-unpack pull <包名> [-o D]    取出 gadget 模式 dump 出的 dex
#   Sources-AI-unpack frida-setup           解压内置 frida 二进制
#
# 免 root 与 root 两条路都走同一份 lib/dump.js，扫内存 DEX 魔数并按
# header 三重校验（header_size / file_size / adler32）去重落盘。
# =============================================================================
set -uo pipefail

PREFIX="${PREFIX:-/data/data/me.sources.ai.debug/files/usr}"
KIT="$PREFIX/opt/Sources-AI-dexkit"
FRIDA="$KIT/frida"
PAYLOAD="$KIT/payload"
TOOLS="$KIT/tools"
LIB="$KIT/lib"
C_WORK="${TMPDIR:-/tmp}/Sources-AI-dexkit"

log()  { printf '\033[36m[dexkit]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[dexkit]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31m[dexkit] %s\033[0m\n' "$*" >&2; exit 1; }

# ------------------------------------------------------------------ 基础检测

has_root() { [ "$(id -u)" = "0" ] || (su -c id 2>/dev/null | grep -q 'uid=0'); }
as_root()  { if [ "$(id -u)" = "0" ]; then bash -c "$*"; else su -c "$*"; fi; }

need() { command -v "$1" >/dev/null 2>&1 || die "缺少命令: $1（请 pkg install $2）"; }

# -------------------------------------------------------------- frida 准备

frida_arch() {
    case "$(uname -m)" in
        aarch64|arm64) echo arm64 ;;
        x86_64|amd64)  echo x86_64 ;;
        armv7l|arm)    echo arm ;;
        i686|i386)     echo x86 ;;
        *) die "未知架构: $(uname -m)" ;;
    esac
}

cmd_frida_setup() {
    local a; a="$(frida_arch)"
    mkdir -p "$FRIDA"
    need xz "xz-utils"
    local n=0
    for xz in "$PAYLOAD"/*.xz; do
        [ -e "$xz" ] || continue
        local base; base="$(basename "$xz" .xz)"
        case "$base" in
            *"-$a"*|*"-$a."*|*"-$a.gz"*) ;;
            * ) continue ;;
        esac
        if [ -f "$FRIDA/$base" ]; then continue; fi
        log "解压 $base"
        xz -dkf -c "$xz" > "$FRIDA/$base" || die "解压失败: $xz"
        chmod 700 "$FRIDA/$base"
        n=$((n+1))
    done
    [ "$n" -gt 0 ] && log "完成，$n 个 frida 组件就位" || log "已是最新，无需解压"
    ls -la "$FRIDA" 2>/dev/null
}

ensure_frida() {
    local a; a="$(frida_arch)"
    [ -x "$FRIDA/frida-inject-$a" ] || [ -x "$FRIDA/frida-server-$a" ] || cmd_frida_setup >/dev/null 2>&1
}

frida_bin() {  # $1 = inject|server
    local a; a="$(frida_arch)"
    local p="$FRIDA/$1-$a"
    [ -x "$p" ] || die "未找到 $p，先执行: Sources-AI-unpack frida-setup"
    echo "$p"
}

# -------------------------------------------------------------- 环境自检

cmd_env() {
    echo "== Sources-AI DEXKit 环境 =="
    echo "PREFIX    : $PREFIX"
    echo "架构       : $(uname -m)"
    echo "root      : $(has_root && echo 可用 || echo 不可用)"
    echo "java      : $(command -v java || echo '缺失 (pkg install openjdk-21)')"
    command -v java >/dev/null 2>&1 && java -version 2>&1 | head -1
    for t in apktool jadx python node git; do
        printf '%-10s: %s\n' "$t" "$(command -v "$t" || echo 缺失)"
    done
    echo "frida     :"
    ls -1 "$FRIDA" 2>/dev/null | sed 's/^/            /' || echo "            未解压，执行 Sources-AI-unpack frida-setup"
    echo "payload   :"
    ls -1 "$PAYLOAD" 2>/dev/null | sed 's/^/            /'
    echo "dump.js   : $LIB/dump.js $([ -f "$LIB/dump.js" ] && echo OK || echo 缺失)"
}

# -------------------------------------------------------------- 静态分析

cmd_static() {
    local apk="${1:?用法: Sources-AI-unpack static <apk> [-o 目录]}"; shift || true
    local out=""
    while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift 2;; *) shift;; esac; done
    [ -f "$apk" ] || die "找不到 APK: $apk"
    [ -n "$out" ] || out="${apk%.apk}-decompiled"
    mkdir -p "$out"

    if command -v apktool >/dev/null 2>&1; then
        log "apktool 反编译资源与 smali -> $out/apktool"
        apktool d -f "$apk" -o "$out/apktool" || warn "apktool 失败"
    else
        warn "apktool 缺失，跳过"
    fi

    if command -v jadx >/dev/null 2>&1; then
        log "jadx 反编译 java -> $out/jadx"
        jadx -d "$out/jadx" --show-bad-code "$apk" || warn "jadx 失败"
    else
        warn "jadx 缺失，跳过"
    fi
    log "完成: $out"
}

# -------------------------------------------------------------- root 脱壳

cmd_root() {
    has_root || die "当前无 root。免 root 请用: Sources-AI-unpack gadget <apk>"
    local target="${1:?用法: Sources-AI-unpack root <包名|apk>}"; shift || true
    local pkg="$target"

    if [ -f "$target" ]; then
        pkg="$(grep -aoE 'package="[^"]+"' <(head -c 200000 "$target") 2>/dev/null | head -1 | sed 's/package="//;s/"//')"
        [ -n "$pkg" ] || die "无法从 APK 解析包名: $target"
        log "APK 包名: $pkg"
    fi

    ensure_frida
    local OUT="${SOURCESAI_DUMP_DIR:-/sdcard/sourcesai_dump}"
    as_root "mkdir -p '$OUT' && chmod 777 '$OUT'" 2>/dev/null || OUT="/data/local/tmp/sourcesai_dump"
    log "输出目录: $OUT"

    local inject="$FRIDA/frida-inject-$(frida_arch)"
    local server="$FRIDA/frida-server-$(frida_arch)"

    if [ -x "$inject" ]; then
        log "frida-inject 注入并执行 dump.js"
        as_root "SOURCESAI_DUMP_DIR='$OUT' '$inject' -f '$pkg' -s '$LIB/dump.js' -q"
    elif [ -x "$server" ]; then
        log "启动 frida-server 后注入安装"
        as_root "'$server' -D &" ; sleep 3
        as_root "'$inject' -f '$pkg' -s '$LIB/dump.js' -q" 2>/dev/null \
            || warn "frida-server 已启动，请用 frida CLI 连接 127.0.0.1:27042 手动执行 dump.js"
    else
        die "未找到 frida-inject / frida-server，先执行 Sources-AI-unpack frida-setup"
    fi
    log "脱壳完成，输出: $OUT"
}

# ---------------------------------------------------- 免 root：gadget 重打包

# 在 smali 里生成 Loader 类并要求启动时 loadLibrary("frida-gadget")
_inject_loader() {
    local src="$1" abi="$2"
    local mf="$src/AndroidManifest.xml"
    [ -f "$mf" ] || die "缺少 AndroidManifest.xml"

    # 取 package
    local pkg
    pkg="$(grep -oE 'package="[^"]+"' "$mf" | head -1 | sed 's/package="//;s/"//')"
    [ -n "$pkg" ] || die "解析 package 失败"

    # 取 <application android:name="...">
    local appname
    appname="$(tr '>' '\n' < "$mf" | grep -oE '<application[^>]*' | grep -oE 'android:name="[^"]+"' | head -1 | sed 's/android:name="//;s/"//')" || true

    # 归一化为全限定名
    local super_cls
    if [ -z "$appname" ]; then
        super_cls="android.app.Application"
        log "原 APK 无自定义 Application，Loader 继承 android.app.Application"
    elif [ "${appname:0:1}" = "." ]; then
        super_cls="${pkg}${appname}"
        log "原 Application: $super_cls"
    elif [[ "$appname" != *.* ]]; then
        super_cls="${pkg}.${appname}"
        log "原 Application: $super_cls"
    else
        super_cls="$appname"
        log "原 Application: $super_cls"
    fi

    local super_smali="L${super_cls//./\/};"
    local loader_cls="com.sourcesai.dexkit.Loader"
    local loader_smali="L${loader_cls//./\/};"

    # smali 目录：优先 smali/，没有则取第一个 smali*
    local sdir="$src/smali"
    [ -d "$sdir" ] || sdir="$(ls -d "$src"/smali* 2>/dev/null | head -1)"
    [ -n "$sdir" ] || die "找不到 smali 目录，apktool 反编译异常"
    local ldir="$sdir/com/sourcesai/dexkit"
    mkdir -p "$ldir"

    cat > "$ldir/Loader.smali" <<EOF
.class public Lcom/sourcesai/dexkit/Loader;
.super $super_smali

.method static constructor <clinit>()V
    .locals 1
    const-string v0, "frida-gadget"
    invoke-static {v0}, Ljava/lang/System;->loadLibrary(Ljava/lang/String;)V
    return-void
.end method

.method public constructor <init>()V
    .locals 0
    invoke-direct {p0}, $super_smali;-><init>()V
    return-void
.end method
EOF

    # 改 manifest：application 的 android:name 指向 Loader
    local py
    py="$(command -v python3 || command -v python)"
    if [ -n "$py" ]; then
        "$py" - "$mf" "$loader_cls" <<'PYEOF'
import re, sys
mf, cls = sys.argv[1], sys.argv[2]
s = open(mf, encoding='utf-8', errors='replace').read()
# 只替换 <application ...> 标签内部的 android:name
def fix(m):
    tag = m.group(0)
    if re.search(r'android:name="[^"]*"', tag):
        return re.sub(r'android:name="[^"]*"', 'android:name="%s"' % cls, tag, count=1)
    return tag.replace('<application', '<application android:name="%s"' % cls, 1)
s = re.sub(r'<application\b[^>]*>', fix, s, count=1)
s = s.replace('android:extractNativeLibs="false"', 'android:extractNativeLibs="true"')
open(mf, 'w', encoding='utf-8').write(s)
print('[dexkit] manifest 已改: android:name=%s' % cls)
PYEOF
    else
        die "需要 python 来改写 AndroidManifest.xml"
    fi
    echo "$abi"
}

cmd_gadget() {
    local apk="${1:?用法: Sources-AI-unpack gadget <apk> [-o 输出.apk]}"; shift || true
    local out=""
    while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift 2;; *) shift;; esac; done
    [ -f "$apk" ] || die "找不到 APK: $apk"
    need apktool "apktool"
    command -v java >/dev/null 2>&1 || die "缺少 java（pkg install openjdk-21）"

    mkdir -p "$C_WORK"
    local src="$C_WORK/src"
    rm -rf "$src"

    log "1/5 apktool 反编译"
    apktool d -f "$apk" -o "$src" >/dev/null || die "apktool 反编译失败"

    # 判断 ABI（优先按 APK 里已有 lib 目录）
    local abi="arm64-v8a"
    if [ -d "$src/lib" ]; then
        if   [ -d "$src/lib/arm64-v8a" ]; then abi="arm64-v8a"
        elif [ -d "$src/lib/x86_64" ];   then abi="x86_64"
        elif [ -d "$src/lib/armeabi-v7a" ]; then abi="armeabi-v7a"
        fi
    fi
    log "2/5 目标 ABI: $abi"

    # frida gadget 的架构名映射
    local g_arch
    case "$abi" in
        arm64-v8a)   g_arch=arm64 ;;
        x86_64)      g_arch=x86_64 ;;
        armeabi-v7a) g_arch=arm ;;
        *) g_arch=arm64 ;;
    esac
    ensure_frida
    local gadget="$FRIDA/frida-gadget-$g_arch.so"
    [ -f "$gadget" ] || die "缺少 $gadget，先执行 Sources-AI-unpack frida-setup"

    local libdir="$src/lib/$abi"
    mkdir -p "$libdir"
    cp "$gadget" "$libdir/libfrida-gadget.so"
    cp "$LIB/dump.js" "$libdir/libsourcesai_dump.js.so"

    cat > "$libdir/libfrida-gadget.config.so" <<'CFGEOF'
{
  "interaction": {
    "type": "script",
    "path": "libsourcesai_dump.js.so",
    "on_change": "reload"
  },
  "log": { "level": "info" }
}
CFGEOF
    log "3/5 gadget + dump.js + config 已注入 $libdir"

    _inject_loader "$src" "$abi" >/dev/null
    log "4/5 重打包"
    local unsigned="$C_WORK/unsigned.apk"
    rm -f "$unsigned"
    apktool b "$src" -o "$unsigned" >/dev/null || die "apktool 重打包失败"

    [ -n "$out" ] || out="${apk%.apk}-gadget.apk"
    log "5/5 签名 -> $out"
    _sign_apk "$unsigned" "$out"
    log "完成。安装后启动目标应用即自动 dump："
    log "    $PREFIX/bin/Sources-AI-unpack pull <包名>"
}

_sign_apk() {
    local in="$1" out="$2"
    local jar="$TOOLS/apksigner.jar"
    local ks="$TOOLS/debug.keystore"
    [ -f "$jar" ] || die "缺少 $jar"
    [ -f "$ks" ]  || die "缺少 $ks"
    java -jar "$jar" sign \
        --ks "$ks" --ks-pass pass:android \
        --key-pass pass:android --ks-key-alias androiddebugkey \
        --v1-signing-enabled true --v2-signing-enabled true \
        --out "$out" "$in" || die "签名失败"
    java -jar "$jar" verify --print-certs "$out" 2>&1 | head -3
}

# -------------------------------------------------------------- 取回 dump

cmd_pull() {
    local pkg="${1:?用法: Sources-AI-unpack pull <包名> [-o 目录]}"; shift || true
    local dest="$PWD"
    while [ $# -gt 0 ]; do case "$1" in -o) dest="$2"; shift 2;; *) shift;; esac; done
    mkdir -p "$dest"

    local src="/data/data/$pkg/files/dump"
    log "源: $src"

    if has_root; then
        as_root "chmod -R 777 '$src' 2>/dev/null; cp -f '$src'/*.dex '$dest'/ 2>/dev/null"
    else
        # debuggable 的应用可用 run-as 读取自身私有目录
        run-as "$pkg" tar -c -C files dump 2>/dev/null | tar -x -C "$dest" 2>/dev/null \
            || die "免 root 取回失败。需目标 APK 在重打包时为 debuggable，或改用 root 模式。"
        [ -d "$dest/dump" ] && mv -f "$dest/dump"/*.dex "$dest"/ 2>/dev/null && rmdir "$dest/dump" 2>/dev/null
    fi

    local n; n="$(ls -1 "$dest"/*.dex 2>/dev/null | wc -l)"
    log "取回 $n 个 dex -> $dest"
    ls -la "$dest"/*.dex 2>/dev/null | head -20
}

# -------------------------------------------------------------- 分发

usage() {
    sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    env)          cmd_env ;;
    static)       shift; cmd_static "$@" ;;
    root)         shift; cmd_root "$@" ;;
    gadget)       shift; cmd_gadget "$@" ;;
    pull)         shift; cmd_pull "$@" ;;
    frida-setup)  cmd_frida_setup ;;
    ""|-h|--help|help) usage ;;
    *) die "未知子命令: $1（试试 Sources-AI-unpack help）" ;;
esac
