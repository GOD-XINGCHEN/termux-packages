# Default.
*           text eol=lf

# Treat patch files as binaries but let diff'ing them
# as normal text.
*.diff      binary diff
*.patch     binary diff
*.patch32   binary diff
*.patch64   binary diff
*.patch.*   binary diff

# Powershell scripts.
*.ps1       text eol=crlf

# Binaries.
*.gpg       binary
*.gz        binary
*.jpg       binary
*.png       binary
*.tar       binary
*.tar.*     binary

# File syntax
*.patch.beforehostbuild linguist-language=RAML
*.patch.beforehostbuild linguist-language=Diff
# Bootstrap opt/ 静态资源（dex2jar / Sources-AI-dexkit）
# 这些是二进制分发文件，必须禁止换行转换，否则 .xz/.jar 会被改坏。
termux-bootstrap-opt/** binary
*.xz        binary
*.jar       binary
*.keystore  binary
